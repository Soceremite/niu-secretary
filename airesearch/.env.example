export PATH=/home/ubuntu/.openclaw/workspace/niu-secretary/airesearch/.venv/bin:$PATH
export PAPER_DB_PATH=/home/ubuntu/.openclaw/workspace/niu-secretary/airesearch/data/paperpipe

# One credential for every OpenCode Go consumer. Keep real values only in the
# ignored airesearch/.env file and enforce mode 600.
export OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
export OPENCODE_GO_API_KEY=
export OPENCODE_GO_PROXY=http://127.0.0.1:7890
export NIU_ASSISTANT_MODEL=deepseek-v4-pro
export AIRESEARCH_BLOG_MODEL=deepseek-v4-pro
export AIRESEARCH_FORMULA_OCR_MODEL=gpt-5.6-luna
export AIRESEARCH_FORMULA_OCR_TIMEOUT_MS=120000

export AIRESEARCH_LLM_MODEL=your-chat-model
export AIRESEARCH_LLM_BASE_URL=https://llm-api.example.com/v1
export AIRESEARCH_LLM_API_KEY=

export TRANSLATE_BASE_URL=https://api.deepseek.com/v1
export TRANSLATE_API_KEY=
export TRANSLATE_MODEL=deepseek-v4-pro

export AIRESEARCH_EMBEDDING_MODEL=text-embedding-v4
export AIRESEARCH_EMBEDDING_BASE_URL=https://embedding-api.example.com/v1
export AIRESEARCH_EMBEDDING_API_KEY=

# DashScope China example:
# export AIRESEARCH_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DashScope international example:
# export AIRESEARCH_EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
SERPAPI_API_KEY=
SERPAPI_MONTHLY_LIMIT=200
SERPAPI_CACHE_TTL_DAYS=30
