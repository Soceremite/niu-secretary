# Niu Secretary Fitness photo nutrition recognition local configuration.
# Copy to /etc/niu-fitness-api.env and fill real values on each server.
# Do not commit real API keys.

FITNESS_API_PORT=5177

# Vision/multimodal model endpoint for meal photo recognition.
FITNESS_VISION_API_BASE=https://your-provider.example/v1/messages
FITNESS_VISION_API_KEY=replace-with-local-secret
FITNESS_VISION_MODEL=qwen3.6-plus
FITNESS_VISION_TIMEOUT_MS=90000
