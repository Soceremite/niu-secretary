# Niu Secretary 2.0 unified API local configuration.
# Copy to /etc/niu-secretary-api.env and fill real values on each server.
# Do not commit real API keys.

NIU_SECRETARY_API_PORT=5188
NIU_SECRETARY_DB_PATH=/var/lib/niu-secretary/niu-secretary.sqlite3

# AI provider credentials and models live only in the ignored
# /home/ubuntu/vibe_proj/niu-secretary/airesearch/.env file. The service wrapper
# sources that file before Python starts. Do not duplicate provider keys here.

# AIResearch native layout v2 OCR fallback for scanned/mixed PDFs.
AIRESEARCH_LAYOUT_OCR_MODE=auto
AIRESEARCH_LAYOUT_OCR_LANGUAGES=eng+chi_sim
AIRESEARCH_LAYOUT_OCR_DPI=220
AIRESEARCH_LAYOUT_OCR_EXECUTABLE=tesseract

# Formula image to LaTeX. Provider credentials and model selection are loaded
# from airesearch/.env.
AIRESEARCH_FORMULA_OCR_MODE=auto
AIRESEARCH_FORMULA_OCR_DPI=260
AIRESEARCH_FORMULA_OCR_MIN_CONFIDENCE=0.70
