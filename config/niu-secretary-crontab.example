# Example crontab for Niu Secretary module jobs.
# Install manually with: crontab config/niu-secretary-crontab.example
# Adjust WORKDIR, PYTHON, and log paths before enabling.

SHELL=/bin/bash
WORKDIR=/home/ubuntu/.openclaw/workspace/niu-secretary
PYTHON=/usr/bin/python3

# Daily module refresh. Cron entrypoints call the public CLI, write module_runs,
# and finish with platform.run-daily to export the unified platform snapshot.
10 7 * * * cd "$WORKDIR" && "$PYTHON" -m niu_secretary.cron daily >> logs/niu-secretary-cron.log 2>&1

# Weekly AIResearch health/refresh audit.
30 8 * * 1 cd "$WORKDIR" && "$PYTHON" -m niu_secretary.cron weekly >> logs/niu-secretary-cron.log 2>&1
